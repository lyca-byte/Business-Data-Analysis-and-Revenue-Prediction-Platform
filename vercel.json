{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/",
      "destination": "/api/index.py"
    },
    {
      "source": "/index.html",
      "destination": "/api/index.py"
    },
    {
      "source": "/dashboard.html",
      "destination": "/api/index.py"
    },
    {
      "source": "/model.html",
      "destination": "/api/index.py"
    },
    {
      "source": "/prediction.html",
      "destination": "/api/index.py"
    },
    {
      "source": "/css/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/js/:path*",
      "destination": "/api/index.py"
    }
  ]
}